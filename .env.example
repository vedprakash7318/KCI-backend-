# ========================================================
# KCI BACKEND PRODUCTION ENVIRONMENT VARIABLES
# ========================================================

# Application Port (Render automatically sets PORT, default is 5000)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kci_db?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=kci_super_secure_jwt_secret_production_key_2025
JWT_EXPIRE=7d

# CORS Allowed Origins
# FRONTEND_URL must match your live Vercel domain without trailing slash
FRONTEND_URL=https://kci-frontend.vercel.app
# BACKEND_URL should be your live Render service URL
BACKEND_URL=https://kci-backend.onrender.com

# Default Admin Credentials
SUPER_ADMIN_EMAIL=admin@kci.org.in
